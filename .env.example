# User configuration - match your host system
# For macOS:
#   USERNAME=yourname
#   USER_HOME=/Users/yourname
#   USER_UID=501
#   USER_GID=20
# For Linux:
#   USERNAME=yourname
#   USER_HOME=/home/yourname
#   USER_UID=1000
#   USER_GID=1000

USERNAME=dev
USER_HOME=/home/dev
USER_UID=1000
USER_GID=1000

# Image naming
IMAGE_NAME=claude-code
IMAGE_TAG=latest
VOLUME_NAME=claude-data

# Host paths to mount
HOST_CODE_DIR=~/code
HOST_CLAUDE_PROJECTS=~/.claude/projects
HOST_SSH_DIR=~/.ssh
HOST_GITCONFIG=~/.gitconfig

# Claude flags (space-separated)
# CLAUDE_FLAGS=--dangerously-skip-permissions

# Optional: pre-auth by mounting existing credentials
# HOST_CLAUDE_CREDENTIALS=~/.claude/credentials.json
